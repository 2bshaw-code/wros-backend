NODE_ENV=production
PORT=3000
APP_NAME=WROS backend

# Core production requirements
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI_PROD=
HOSTING_URL=https://wros-frontend.onrender.com
CONSOLE_URL=https://wros-console.onrender.com/console
FRONTEND_URL=https://wros-frontend.onrender.com
PUBLIC_WEBSITE_URL=https://wros-frontend.onrender.com
API_URL=https://wros-backend.onrender.com/api

# Optional aliases supported by the backend
REFRESH_TOKEN_SECRET=

# Optional provider feature flags. Set to true only when credentials are supplied.
ENABLE_STRIPE=false
ENABLE_WHATSAPP=false
STRIPE_SECRET_KEY=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_APP_SECRET=

# Merchant application feature flags
CRM_ENABLED=true
ORDERS_ENABLED=true
INVOICES_ENABLED=true
DELIVERY_ENABLED=true
LDM_ENABLED=true
WHATSAPP_RIDER_MODE=true
FAULTS_ENABLED=true
DOWNLOADS_ENABLED=true
WROS_IOS_DOWNLOAD_URL=
WROS_ANDROID_DOWNLOAD_URL=
WROS_MAC_DOWNLOAD_URL=
WROS_WINDOWS_DOWNLOAD_URL=

# Optional diagnostics and migration inputs
WROS_TEST_MODE=false
WROS_LOG_MESSAGES=false
WROS_SAFE_STARTUP=true
WROS_BACKFILL_TENANT_ID=
DOTENV_CONFIG_PATH=

# Optional BOB cloud engine. Leave blank for local-only operation.
BOB_CLOUD_URL=
BOB_CLOUD_API_KEY=
BOB_CLOUD_TIMEOUT_MS=8000
